        <!-- ==================== MAIN FLOW ARROWS (Cross-Swimlane) ==================== -->
        
        <!-- Flow 1: Login -->
        <mxCell id="flow1-client-gateway" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#C62828;fontStyle=1;fontSize=14;labelBackgroundColor=#FFCDD2;startArrow=none;endArrow=classic;" edge="1" parent="1" source="api-client" target="api-gateway">
